{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app.main:app", "--reload"],
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "Test embed genai",
